{
  "name": "silmaril",
  "version": "0.4.0",
  "description": "Compile-time reactivity for JS",
  "keywords": [
    "babel",
    "compiler",
    "reactivity",
    "rollup",
    "unplugin",
    "vite"
  ],
  "homepage": "https://github.com/lxsmnsyc/silmaril/tree/main/packages/silmaril",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/silmaril/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/silmaril.git",
    "directory": "packages/silmaril"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./babel": "./dist/babel.mjs",
    "./compiler": "./dist/compiler.mjs",
    "./solid": "./dist/solid.mjs",
    "./store": "./dist/store.mjs",
    "./unplugin": "./dist/unplugin.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@babel/core": "^8.0.9",
    "@babel/helper-module-imports": "^8.0.0",
    "@babel/types": "^8.0.8",
    "magic-string": "^1.4.4",
    "oxc-parser": "0.155.0",
    "unplugin": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "solid-js": "^1.9.17",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@oxc-parser/binding-wasm32-wasip1": "0.155.0",
    "solid-js": "^1.7"
  },
  "peerDependenciesMeta": {
    "@oxc-parser/binding-wasm32-wasip1": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
