{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation website of silmaril, built with brumate",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/server.ts --outDir dist/server",
    "preview": "node scripts/preview.ts",
    "type-check": "brumate-tsc --noEmit",
    "check:samples": "node scripts/check-samples.ts"
  },
  "dependencies": {
    "@oxc-parser/binding-wasm32-wasip1": "0.155.0",
    "brumate": "0.3.0",
    "silmaril": "workspace:*"
  },
  "devDependencies": {
    "@brumate/tsc": "0.1.3",
    "@twinkleplop/bash": "0.1.7",
    "@twinkleplop/css": "0.1.7",
    "@twinkleplop/json": "0.1.7",
    "@twinkleplop/markdown-it": "0.1.7",
    "@twinkleplop/theme-github": "0.2.4",
    "@twinkleplop/tsx": "0.1.7",
    "@twinkleplop/typescript": "0.1.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.6.5",
    "markdown-it": "14.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
