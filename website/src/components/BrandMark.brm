      <stop offset="1" stop-color="#6b7cff" />
    </linearGradient>
  </defs>
  <path d="M16 2.5 28 12 16 29.5 4 12Z" fill="url(#brand-fill)" />
  <path d="M16 2.5 28 12 16 29.5 4 12Z M4 12h24M11 12l5-9.5 5 9.5-5 17.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
