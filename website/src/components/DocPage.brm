<script>
  import { $client, $props, $signal } from 'brumate/signals';
  import { addCopyButtons, followHeadings } from '../docs-client/enhance.ts';
  import { pages, sections } from '../docs.ts';
  import Icon from './Icon.brm';
  import LiveSample from './LiveSample.brm';
  import Meta from './Meta.brm';

  // A page of the docs: its title, its parts, the links to the pages before and after it, and
  // an outline that follows the section in view. The sidebar is in `DocsShell.brm`.
  const { slug } = $props<{ slug: string }>();
  const base = import.meta.env.BASE_URL;
  const brand = 'silmaril';
  const page = pages[slug];
  const order = sections.flatMap((group) => group.pages);
  const index = order.findIndex((item) => item.slug === slug);
  const previous = index > 0 ? order[index - 1] : undefined;
  const next = index !== -1 ? order[index + 1] : undefined;
  const link = (target: string): string => `${base}docs${target ? `/${target}` : ''}`;
  const contents = (page?.headings ?? []).filter(
    (heading) => heading.level === 2 || heading.level === 3,
  );
  // The kicker above the title names the sidebar section of the page.
  const kicker = sections.find((group) => group.pages.some((item) => item.slug === slug))?.title;
  const title = page ? (page.title === brand ? brand : `${page.title} | ${brand}`) : `Not found | ${brand}`;

  let article = $signal<HTMLElement>();
  let toc = $signal<HTMLElement>();

  $client(() => {
    if (!article) {
      return undefined;
    }
    addCopyButtons(article);
    return toc ? followHeadings(article, toc) : undefined;
  }, 'idle');
</script>

#head {
  <title>{title}</title>
}

#if (page) {
  <Meta title=title description=page.description path=(slug ? `docs/${slug}` : 'docs') type="article" />
}
<article class="prose" ref=$bind(article)>
  #if (page) {
    <header class="doc-head">
      #if (kicker) {
        <p class="doc-kicker">{kicker}</p>
      }
      <h1 class="doc-title">{page.title}</h1>
    </header>
    <div class="doc-body">
      #for (part, position of page.parts by position) {
        #if ('sample' in part) {
          <LiveSample name=(part.sample.name) source=(part.sample.source) />
        } #else {
          {part.html}
        }
      }
    </div>
    #if (previous || next) {
      <nav class="pager" aria-label="Pages">
        #if (previous) {
          <a class="previous" href=(link(previous.slug))>
            <small><span class="pager-icon"><Icon name="arrow-left" size=(14) /></span>Previous</small>
            <span>{previous.title}</span>
          </a>
        }
        #if (next) {
          <a class="next" href=(link(next.slug))>
            <small>Next<span class="pager-icon"><Icon name="arrow-right" size=(14) /></span></small>
            <span>{next.title}</span>
          </a>
        }
      </nav>
    }
  } #else {
    <header class="doc-head">
      <h1 class="doc-title">Not found</h1>
    </header>
    <p>No page at this address. <a href=(link(''))>Back to the documentation</a>.</p>
  }
</article>
<nav class="toc" aria-label="On this page" ref=$bind(toc)>
  #if (contents.length > 0) {
    <p class="toc-title">On this page</p>
    <span class="toc-indicator" aria-hidden="true"></span>
    #for (heading of contents by heading.id) {
      <a href=(`#${heading.id}`) class={ 'level-3': heading.level === 3 }>{heading.text}</a>
    }
  }
</nav>
