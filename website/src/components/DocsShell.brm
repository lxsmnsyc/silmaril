<script>
  import { $client, $effect, $props, $route, $signal } from 'brumate/signals';

  // The sidebar of the docs. It is in a layout, so it stays when a link loads another page,
  // with its scroll position. The page and its outline come in `children`.
  const { sections, label, children } = $props<{
    sections: { title: string; pages: { slug: string; title: string }[] }[];
    label: string;
    children?: unknown;
  }>();
  const route = $route();
  const base = import.meta.env.BASE_URL;
  const link = (target: string): string => `${base}docs${target ? `/${target}` : ''}`;

  /** The page of the section at a path, such as `limits` for `/docs/limits`. */
  const slugOf = (pathname: string): string =>
    pathname.slice(`${base}docs`.length).replace(/^\/|\/$/g, '');

  let menu = $signal<HTMLDetailsElement>();
  let sidebar = $signal<HTMLElement>();

  // On a narrow screen the menu closes when a link loads another page.
  $effect(() => {
    void route.url.pathname;
    menu?.removeAttribute('open');
  });

  // A long sidebar scrolls on its own. It opens with the current page in view.
  $client(() => {
    const list = sidebar;
    const current = list?.querySelector<HTMLElement>('[aria-current="page"]');
    if (list && current && current.offsetTop + current.offsetHeight > list.clientHeight) {
      list.scrollTop = current.offsetTop - list.clientHeight / 2;
    }
  });
</script>

<div class="progress" aria-hidden="true"></div>
<div class="docs">
  <details class="menu" ref=$bind(menu)>
    <summary>
      Menu
      <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
  </details>
  <nav class="sidebar" aria-label=label ref=$bind(sidebar)>
    #for (section, index of sections by section.title) {
      <p class={ 'sidebar-title': true, 'sidebar-title-next': index > 0 }>{section.title}</p>
      #for (item of section.pages by item.slug) {
        <a
          href=(link(item.slug))
          aria-current=(item.slug === slugOf(route.url.pathname) ? 'page' : undefined)
        >{item.title}</a>
      }
    }
  </nav>
  {children}
</div>
