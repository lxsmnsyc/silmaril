<script>
  import { $route } from 'brumate/signals';
  import Icon from './Icon.brm';
  import Search from './Search.brm';
  import { switchTheme } from '../theme-switch.ts';

  const route = $route();
  const base = import.meta.env.BASE_URL;
  const docs = `${base}docs`;
</script>

<header class="header">
  <div class="header-inner">
    <a class="brand" href=base aria-label="silmaril">
      <img src=(`${base}logo.svg`) alt="" width="28" height="28">
      <span>silmaril</span>
    </a>
    <div class="header-slot">
      <Search />
    </div>
    <nav class="header-nav" aria-label="Main">
      <a
        class="nav-link"
        href=(`${docs}/getting-started`)
        aria-current=(route.url.pathname === `${docs}/getting-started` ? 'page' : undefined)
      >Get started</a>
      <a
        class="nav-link"
        href=docs
        aria-current=(route.url.pathname.startsWith(docs) && route.url.pathname !== `${docs}/getting-started` ? 'page' : undefined)
      >Docs</a>
      <a class="icon-button github-link" href="https://github.com/lxsmnsyc/silmaril" aria-label="silmaril on GitHub" title="silmaril on GitHub">
        <Icon name="github" size=(18) />
      </a>
      <button class="icon-button theme-toggle" type="button" onClick=(() => switchTheme())>
        <span class="moon"><Icon name="moon" size=(18) /><span class="visually-hidden">Switch to dark theme</span></span>
        <span class="sun"><Icon name="sun" size=(18) /><span class="visually-hidden">Switch to light theme</span></span>
      </button>
    </nav>
  </div>
</header>
