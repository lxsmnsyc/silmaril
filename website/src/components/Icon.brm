<script>
  import { $props } from 'brumate/signals';

  /**
   * An icon of the site: a stroke on a grid of 24, in the color of the text. It is decoration,
   * so it is hidden from screen readers. Name what it does on the button or link around it.
   */
  const { name, size = 16, ...rest } = $props<{
    name:
      | 'check'
      | 'minus'
      | 'plus'
      | 'close'
      | 'search'
      | 'upload'
      | 'sun'
      | 'moon'
      | 'arrow-right'
      | 'chevron'
      | 'grip';
    size?: number;
    [attribute: string]: unknown;
  }>();
</script>

<svg
  class=(`icon icon-${name}`)
  viewBox="0 0 24 24"
  width=size
  height=size
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  #switch {
    #case (name === 'check') {
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    }
    #case (name === 'minus') {
      <path d="M6 12h12" />
    }
    #case (name === 'plus') {
      <path d="M12 5v14M5 12h14" />
    }
    #case (name === 'close') {
      <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" />
    }
    #case (name === 'search') {
      <circle cx="10.5" cy="10.5" r="6" />
      <path d="M15 15l5 5" />
    }
    #case (name === 'upload') {
      <path d="M12 15V4M7.5 8.5L12 4l4.5 4.5M5 15v4h14v-4" />
    }
    #case (name === 'sun') {
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    }
    #case (name === 'moon') {
      <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" />
    }
    #case (name === 'chevron') {
      <path d="M6 9l6 6 6-6" />
    }
    #case (name === 'grip') {
      <path d="M9 6h.01M15 6h.01M9 12h.01M15 12h.01M9 18h.01M15 18h.01" />
    }
    #case (name === 'arrow-right') {
      <path d="M5 12h14M13 6l6 6-6 6" />
    }
  }
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.15em;
  }
</style>
