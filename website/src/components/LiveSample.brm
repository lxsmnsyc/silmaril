<script>
  import { $client, $props, $signal } from 'brumate/signals';

  // A code sample of the docs that compiles and runs in the page. Editing it runs it again.
  const { name, source: initial } = $props<{ name: string; source: string }>();

  let source = $signal(initial);
  let logs = $signal<string[]>([]);
  let compiled = $signal('');
  let error = $signal('');
  let status = $signal<'idle' | 'running' | 'done' | 'compiled'>('idle');
  let view = $signal<'logs' | 'compiled'>('logs');
  // Counts runs, so a run that finishes after a newer one started writes nothing.
  let runs = $signal(0);

  async function run() {
    runs++;
    const id = runs;
    status = 'running';
    error = '';
    logs = [];
    try {
      const { runSample } = await import('../live/run.ts');
      const result = await runSample(source, {
        isLatest: () => id === runs,
        onLog: (line) => {
          logs = [...logs, line];
        },
      }, name);
      if (id === runs) {
        compiled = result.code;
        status = result.ran ? 'done' : 'compiled';
      }
    } catch (caught) {
      if (id === runs) {
        error = caught instanceof Error ? caught.message : String(caught);
        status = 'idle';
      }
    }
  }

  // The sample runs once the page has loaded.
  $client(() => {
    void run();
  });
</script>

<figure class="live">
  <div class="live-bar">
    <span class="live-file">{name}</span>
    <span class="live-status">
      #if (status === 'running') {
        Running
      } #else if (status === 'compiled') {
        Compiled, not run
      } #else if (status === 'done') {
        Done
      }
    </span>
    <button type="button" class="live-run" onClick=(() => void run())>Run</button>
  </div>
  <textarea
    class="live-editor"
    aria-label=(`Source of ${name}`)
    spellcheck="false"
    rows=(source.split('\n').length)
    value=source
    onInput=((event) => {
      source = event.currentTarget.value;
      // Typing pauses before the sample compiles again.
      const typed = source;
      setTimeout(() => {
        if (typed === source) {
          void run();
        }
      }, 400);
    })
  >{initial}</textarea>
  <div class="live-tabs" role="tablist">
    <button type="button" role="tab" aria-selected=(view === 'logs') class={ active: view === 'logs' } onClick=(() => (view = 'logs'))>Logs</button>
    <button type="button" role="tab" aria-selected=(view === 'compiled') class={ active: view === 'compiled' } onClick=(() => (view = 'compiled'))>Compiled</button>
  </div>
  #if (error) {
    <pre class="live-error">{error}</pre>
  }
  #if (view === 'logs') {
    <div class="live-logs">
      #for (line, index of logs by index) {
        <p>{line}</p>
      } #else {
        <p class="live-empty">{status === 'compiled' ? 'The compiler does not generate code yet, so this sample is not run.' : 'No logs.'}</p>
      }
    </div>
  } #else {
    <pre class="live-compiled">{compiled}</pre>
  }
</figure>

<style>
  /* Live samples of the docs */

  .live {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    overflow: hidden;
  }

  .live-bar,
  .live-tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0.5rem;
    background: var(--surface);
    font: 0.8rem var(--mono);
  }

  .live-bar {
    border-bottom: 1px solid var(--border);
  }

  .live-tabs {
    border-top: 1px solid var(--border);
  }

  .live-bar button,
  .live-tabs button {
    padding: 0.15rem 0.6rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }

  .live-bar .live-run {
    border-color: var(--border);
    color: var(--text);
  }

  .live-tabs button.active {
    border-color: var(--border);
    background: var(--code-bg);
    color: var(--text);
  }

  .live-file {
    color: var(--muted);
  }

  .live-status {
    margin-left: auto;
    color: var(--muted);
  }

  .live-editor {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0.9rem 1.1rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font: 0.85rem/1.6 var(--mono);
    white-space: pre;
    overflow-x: auto;
    resize: none;
    tab-size: 2;
  }

  .live-editor:focus {
    outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    outline-offset: -2px;
  }

  .live-logs,
  .live-compiled {
    margin: 0;
    padding: 0.75rem 1.1rem;
    border: 0;
    border-radius: 0;
    background: var(--bg);
    color: var(--text);
    font: 0.85rem/1.6 var(--mono);
    overflow-x: auto;
  }

  .live-logs p {
    margin: 0;
  }

  .live-empty {
    color: var(--muted);
  }

  .live-error {
    margin: 0;
    padding: 0.75rem 1.1rem;
    border: 0;
    border-radius: 0;
    background: color-mix(in srgb, #e5484d 12%, var(--bg));
    color: var(--text);
    white-space: pre-wrap;
  }
</style>
