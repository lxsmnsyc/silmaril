<script>
  import { raw } from 'brumate/html';
  import HeroDemo from '../components/HeroDemo.brm';
  import Icon from '../components/Icon.brm';
  import InstallCommand from '../components/InstallCommand.brm';
  import Meta from '../components/Meta.brm';
  import compiled from '../hero/cart.js?compiled';
  import withSilmaril from '../hero/compare-silmaril.js?highlight';
  import withSignals from '../hero/compare-signals.js?highlight';

  const base = import.meta.env.BASE_URL;
  const description =
    'silmaril makes plain let variables reactive at compile time. No signal API, no framework, and a runtime under 1.5 kB gzipped.';
  const bundlers = ['Vite', 'Rollup', 'Rolldown', 'esbuild', 'webpack', 'Rspack', 'Rsbuild', 'Farm', 'Bun'];
</script>

#head {
  <title>silmaril: compile-time reactivity for JS</title>
}

<Meta title="silmaril: compile-time reactivity for JS" description=description path="" />
<main class="home">
  <section class="hero">
    <h1>Assign a variable. Only the code that reads it runs.</h1>
    <p class="lead">
      silmaril makes plain <code>let</code> variables reactive at compile time. No signal API, no
      framework, and a runtime under 1.5&nbsp;kB gzipped.
    </p>
    <div class="actions">
      <a class="button primary" href=(`${base}docs/getting-started`)>
        Get started
        <Icon name="arrow-right" />
      </a>
      <InstallCommand />
    </div>
    <HeroDemo />
  </section>

  <section class="feature">
    <div class="feature-text">
      <h2>No signals. No <code>.value</code>.</h2>
      <p>
        State is a <code>let</code>, and an update is an assignment. The compiler rewrites reads
        and writes, so your source stays plain JS and TS.
      </p>
      <a class="more" href=(`${base}docs/basic-reactivity`)>Basic reactivity <Icon name="arrow-right" /></a>
    </div>
    <div class="compare">
      <figure class="code-card">
        <figcaption>silmaril</figcaption>
        <div class="code">{raw(withSilmaril.html)}</div>
      </figure>
      <figure class="code-card muted">
        <figcaption>Signals, Solid 2.0</figcaption>
        <div class="code">{raw(withSignals.html)}</div>
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="feature-text">
      <h2>Dependencies found at build time.</h2>
      <p>
        The compiler lists which code reads each variable. A write runs that list, with no
        tracking while your code runs.
      </p>
      <a class="more" href=(`${base}docs/internals`)>How it works <Icon name="arrow-right" /></a>
    </div>
    <figure class="code-card">
      <figcaption>The demo above, compiled</figcaption>
      <div class="code">{raw(compiled.html)}</div>
    </figure>
  </section>

  <section class="feature">
    <div class="feature-text">
      <h2>Under 1.5 kB of runtime.</h2>
      <p>The runtime has no dependencies. A test fails the build when it grows past the limit.</p>
    </div>
    <div class="stat">
      <p class="stat-value">&lt; 1.5<span> kB</span></p>
      <p class="stat-foot">
        Minified and gzipped, measured by <code>packages/silmaril/test/size.test.ts</code>.
      </p>
    </div>
  </section>

  <section class="feature">
    <div class="feature-text">
      <h2>Any bundler, any UI library.</h2>
      <p>
        One plugin covers nine bundlers. Stores pass values to event emitters, global state or
        Solid signals.
      </p>
      <a class="more" href=(`${base}docs/bundler-setup`)>Bundler setup <Icon name="arrow-right" /></a>
    </div>
    <ul class="chips">
      #for (bundler of bundlers) {
        <li>{bundler}</li>
      }
    </ul>
  </section>

  <section class="table-section">
    <h2>How it compares</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">silmaril 0.5</th>
            <th scope="col">Svelte 5 runes</th>
            <th scope="col">Solid 2.0 signals</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">State</th>
            <td><code>let count = 0</code></td>
            <td><code>let count = $state(0)</code></td>
            <td><code>createSignal(0)</code></td>
          </tr>
          <tr>
            <th scope="row">Dependencies found</th>
            <td>At compile time</td>
            <td>At run time</td>
            <td>At run time</td>
          </tr>
          <tr>
            <th scope="row">Works in</th>
            <td>Any compiled <code>.js</code> or <code>.ts</code> file</td>
            <td><code>.svelte</code>, <code>.svelte.js</code> and <code>.svelte.ts</code> files</td>
            <td>Any file</td>
          </tr>
          <tr>
            <th scope="row">Renders UI</th>
            <td>No. Pair it with a UI library through stores.</td>
            <td>Yes</td>
            <td>Yes</td>
          </tr>
          <tr>
            <th scope="row">Needs a build step</th>
            <td>Yes</td>
            <td>Yes</td>
            <td>No</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="foot">Compared in November 2026.</p>
  </section>

  <section class="facts" aria-label="Facts">
    <dl>
      <div><dt>License</dt><dd>MIT</dd></div>
      <div><dt>Runtime</dt><dd>&lt; 1.5 kB, no dependencies</dd></div>
      <div><dt>Compiler</dt><dd>Node.js 22.18 or 24.11+</dd></div>
      <div><dt>Format</dt><dd>ESM only</dd></div>
      <div><dt>Version</dt><dd>0.5, before 1.0</dd></div>
    </dl>
  </section>

  <section class="final">
    <h2>Make your first variable reactive.</h2>
    <div class="actions">
      <a class="button primary" href=(`${base}docs/getting-started`)>
        Get started
        <Icon name="arrow-right" />
      </a>
      <a class="button" href="https://github.com/lxsmnsyc/silmaril" target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </section>
</main>

