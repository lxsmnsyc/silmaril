<script>
  import { raw } from 'brumate/html';
  import runtimeBytes from 'virtual:runtime-size';
  import HeroDemo from '../components/HeroDemo.brm';
  import Icon from '../components/Icon.brm';
  import InstallCommand from '../components/InstallCommand.brm';
  import Meta from '../components/Meta.brm';
  import compiled from '../hero/cart.js?compiled';
  import withSilmaril from '../hero/compare-silmaril.js?highlight';
  import withSignals from '../hero/compare-signals.js?highlight';

  const base = import.meta.env.BASE_URL;
  // Measured when the site builds, by `plugins/runtime-size.ts`.
  const runtimeKb = (runtimeBytes / 1000).toFixed(2);
  const description = `silmaril makes plain let variables reactive at compile time. No signal API, no framework, and a ${runtimeKb} kB runtime.`;
  const bundlers = ['Vite', 'Rollup', 'Rolldown', 'esbuild', 'webpack', 'Rspack', 'Rsbuild', 'Farm', 'Bun'];
</script>

#head {
  <title>silmaril: compile-time reactivity for JS</title>
}

<Meta title="silmaril: compile-time reactivity for JS" description=description path="" />
<main class="home">
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-title">Assign a variable. Only its <em>readers</em> run.</h1>
      <p class="lead">
        silmaril makes plain <code>let</code> variables reactive at compile time. No signal API, no
        framework, and a {runtimeKb}&nbsp;kB runtime.
      </p>
      <InstallCommand />
      <div class="actions">
        <a class="button primary" href=(`${base}docs/getting-started`)>
          Get started
          <span class="button-icon"><Icon name="arrow-right" size=(16) /></span>
        </a>
        <a class="button quiet" href=(`${base}docs`)>Read the docs</a>
      </div>
    </div>
    <HeroDemo />
  </section>

  <section class="section" aria-labelledby="plain">
    <header class="section-head">
      <p class="section-index">01</p>
      <h2 id="plain">No signals. No <code>.value</code>.</h2>
      <p>State is a <code>let</code>, and an update is an assignment. The compiler rewrites reads and writes.</p>
    </header>
    <div class="compare">
      <figure class="compare-pane">
        <figcaption><span class="compare-lang">Signals, Solid 2.0</span><span class="compare-file">count.js</span></figcaption>
        <div class="code-block">{raw(withSignals.html)}</div>
      </figure>
      <figure class="compare-pane">
        <figcaption><span class="compare-lang">silmaril</span><span class="compare-file">count.js</span></figcaption>
        <div class="code-block">{raw(withSilmaril.html)}</div>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="graph">
    <header class="section-head">
      <p class="section-index">02</p>
      <h2 id="graph">Dependencies found at build time.</h2>
      <p>
        The compiler lists which code reads each variable. A write runs that list, with no tracking
        while your code runs. <a href=(`${base}docs/internals`)>How it works</a>
      </p>
    </header>
    <figure class="window">
      <div class="window-bar">
        <span class="window-title">cart.js, compiled</span>
      </div>
      <div class="code-block">{raw(compiled.html)}</div>
    </figure>
  </section>

  <section class="section" aria-labelledby="size">
    <header class="section-head">
      <p class="section-index">03</p>
      <h2 id="size">A small runtime with no dependencies.</h2>
      <p>A test fails when the runtime reaches 1.5&nbsp;kB.</p>
    </header>
    <div class="row">
      <div class="tile stat-tile">
        <p class="stat-value">{runtimeKb}<span> kB</span></p>
        <p class="stat-label">
          <code>silmaril</code> minified and gzipped, measured when this site was built.
        </p>
      </div>
      <div class="tile">
        <p class="tile-title">One plugin, nine bundlers</p>
        <ul class="chips">
          #for (bundler of bundlers) {
            <li class="chip">{bundler}</li>
          }
        </ul>
        <a class="more" href=(`${base}docs/bundler-setup`)>Bundler setup <Icon name="arrow-right" size=(16) /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="compare">
    <header class="section-head">
      <p class="section-index">04</p>
      <h2 id="compare">How it compares.</h2>
      <p>Svelte and Solid render UI. silmaril only does reactivity, and pairs with a UI library through stores.</p>
    </header>
    <div class="tile">
      <div class="table-scroll" role="group" aria-label="Comparison" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">silmaril 0.5</th>
              <th scope="col">Svelte 5 runes</th>
              <th scope="col">Solid 2.0 signals</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">State</th>
              <td><code>let count = 0</code></td>
              <td><code>let count = $state(0)</code></td>
              <td><code>createSignal(0)</code></td>
            </tr>
            <tr>
              <th scope="row">Dependencies found</th>
              <td>At compile time</td>
              <td>At run time</td>
              <td>At run time</td>
            </tr>
            <tr>
              <th scope="row">Works in</th>
              <td>Any compiled <code>.js</code> or <code>.ts</code> file</td>
              <td><code>.svelte</code>, <code>.svelte.js</code> and <code>.svelte.ts</code> files</td>
              <td>Any file</td>
            </tr>
            <tr>
              <th scope="row">Renders UI</th>
              <td>No</td>
              <td>Yes</td>
              <td>Yes</td>
            </tr>
            <tr>
              <th scope="row">Needs a build step</th>
              <td>Yes</td>
              <td>Yes</td>
              <td>No</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="tile-foot">Compared in November 2026.</p>
    </div>
  </section>

  <section class="section" aria-label="Facts">
    <dl class="tile facts">
      <div><dt>License</dt><dd>MIT</dd></div>
      <div><dt>Runtime</dt><dd>{runtimeKb} kB, no dependencies</dd></div>
      <div><dt>Compiler</dt><dd>Node.js 22.18 or 24.11+</dd></div>
      <div><dt>Format</dt><dd>ESM only</dd></div>
      <div><dt>Version</dt><dd>0.5, before 1.0</dd></div>
    </dl>
  </section>

  <section class="cta">
    <h2>Make your first variable reactive.</h2>
    <div class="actions">
      <a class="button primary" href=(`${base}docs/getting-started`)>
        Get started
        <span class="button-icon"><Icon name="arrow-right" size=(16) /></span>
      </a>
      <a class="button quiet" href="https://github.com/lxsmnsyc/silmaril">GitHub</a>
    </div>
  </section>
</main>

<style>
  /* Tiles of the home page that the global styles do not cover */

  .tile {
    padding: var(--pad);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }

  .stat-tile {
    display: grid;
    align-content: space-between;
    gap: 24px;
  }

  .stat-value {
    margin: 0;
    font: 800 clamp(3.5rem, 8vw, 6rem) / 1 var(--font-sans);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .stat-value span {
    color: var(--muted);
    font-size: 0.4em;
    letter-spacing: 0;
  }

  .stat-label,
  .tile-foot {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .tile-foot {
    margin-top: 12px;
  }

  .tile-title {
    margin: 0 0 16px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 14px;
    border-radius: var(--radius-full);
    background: var(--surface-strong);
    font: 500 14px var(--font-sans);
  }

  .more {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-weight: 600;
    text-decoration-line: underline;
  }

  .section-head a {
    text-decoration-line: underline;
  }

  .table-scroll {
    margin: 0;
  }

  .table-scroll tbody th {
    color: var(--muted);
    font-weight: 500;
    text-align: start;
    white-space: nowrap;
  }

  .table-scroll tbody tr:nth-child(odd) th {
    border-radius: 10px 0 0 10px;
    background: var(--surface);
  }

  .table-scroll tbody tr:nth-child(odd) td:first-child {
    border-radius: 0;
  }

  .table-scroll td:nth-child(2) {
    font-weight: 600;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 16px 24px;
    margin: 0;
  }

  .facts dt {
    color: var(--muted);
    font-size: 14px;
  }

  .facts dd {
    margin: 4px 0 0;
    font-weight: 600;
  }

  .cta {
    display: grid;
    gap: 20px;
    justify-items: center;
    padding: 56px 32px;
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--on-ink);
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .cta :focus-visible {
    outline-color: var(--on-ink);
  }

  .lead code {
    background: color-mix(in srgb, var(--on-ink) 14%, transparent);
  }

  @media (max-width: 70rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 48rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile {
      padding: 20px;
    }
  }
